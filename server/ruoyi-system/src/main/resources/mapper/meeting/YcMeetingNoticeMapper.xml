<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.ruoyi.system.mapper.YcMeetingNoticeMapper"><resultMap id="Notice" type="YcMeetingNotice"><id property="noticeId" column="notice_id"/><result property="activityId" column="activity_id"/><result property="title" column="title"/><result property="contentHtml" column="content_html"/><result property="priority" column="priority"/><result property="visibility" column="visibility"/><result property="status" column="status"/><result property="publishTime" column="publish_time"/><result property="validEnd" column="valid_end"/><result property="delFlag" column="del_flag"/></resultMap><sql id="columns">notice_id,activity_id,title,content_html,priority,visibility,status,publish_time,valid_end,del_flag,create_by,create_time,update_by,update_time,remark</sql><select id="selectById" resultMap="Notice">select <include refid="columns"/> from yc_meeting_notice where notice_id=#{noticeId} and del_flag='0'</select><select id="selectList" resultMap="Notice">select <include refid="columns"/> from yc_meeting_notice <where>del_flag='0'<if test="activityId != null"> and activity_id=#{activityId}</if><if test="status != null and status != ''"> and status=#{status}</if></where> order by publish_time desc,notice_id desc</select><insert id="insert" useGeneratedKeys="true" keyProperty="noticeId">insert into yc_meeting_notice(activity_id,title,content_html,priority,visibility,status,publish_time,valid_end,del_flag,create_by,create_time,remark) values(#{activityId},#{title},#{contentHtml},#{priority},#{visibility},#{status},#{publishTime},#{validEnd},'0',#{createBy},sysdate(),#{remark})</insert><update id="update">update yc_meeting_notice set title=#{title},content_html=#{contentHtml},priority=#{priority},visibility=#{visibility},status=#{status},publish_time=#{publishTime},valid_end=#{validEnd},update_by=#{updateBy},update_time=sysdate(),remark=#{remark} where notice_id=#{noticeId} and del_flag='0'</update><insert id="markRead">insert ignore into yc_user_notice_read(notice_id,mp_user_id,read_time) values(#{noticeId},#{userId},sysdate())</insert><select id="hasRead" resultType="boolean">select exists(select 1 from yc_user_notice_read where notice_id=#{noticeId} and mp_user_id=#{userId})</select></mapper>
