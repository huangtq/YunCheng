<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YcMeetingFeedbackMapper">
  <resultMap id="Feedback" type="YcMeetingFeedback"><id property="feedbackId" column="feedback_id"/><result property="activityId" column="activity_id"/><result property="mpUserId" column="mp_user_id"/><result property="rating" column="rating"/><result property="content" column="content"/><result property="status" column="status"/><result property="createdTime" column="created_time"/></resultMap>
  <insert id="insert" useGeneratedKeys="true" keyProperty="feedbackId">insert into yc_meeting_feedback(activity_id,mp_user_id,rating,content,status,created_time) values(#{activityId},#{mpUserId},#{rating},#{content},'submitted',sysdate())</insert>
  <select id="selectList" resultMap="Feedback">select feedback_id,activity_id,mp_user_id,rating,content,status,created_time from yc_meeting_feedback where activity_id=#{activityId} order by created_time desc</select>
  <select id="selectStats" resultType="java.util.HashMap">select count(1) as totalCount,ifnull(avg(rating),0) as averageRating,sum(case when status='submitted' then 1 else 0 end) as pendingCount from yc_meeting_feedback where activity_id=#{activityId}</select>
</mapper>
