<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.ruoyi.system.mapper.YcCheckinLogMapper"><resultMap id="Log" type="YcCheckinLog"><id property="checkinLogId" column="checkin_log_id"/><result property="activityId" column="activity_id"/><result property="passId" column="pass_id"/><result property="applyOrderId" column="apply_order_id"/><result property="checkinType" column="checkin_type"/><result property="action" column="action"/><result property="checkpoint" column="checkpoint"/><result property="operatorName" column="operator_name"/><result property="deviceId" column="device_id"/><result property="occurredTime" column="occurred_time"/><result property="idempotencyKey" column="idempotency_key"/><result property="result" column="result"/><result property="reason" column="reason"/></resultMap><select id="selectByIdempotencyKey" resultMap="Log">select * from yc_checkin_log where idempotency_key=#{idempotencyKey}</select><select id="selectCheckpointStats" resultType="java.util.HashMap">select checkpoint, count(1) as scan_count, sum(case when result='success' and action='checkin' then 1 else 0 end) as success_count, max(occurred_time) as last_scan_time from yc_checkin_log where activity_id=#{activityId} group by checkpoint order by last_scan_time desc</select><insert id="insert" useGeneratedKeys="true" keyProperty="checkinLogId">insert into yc_checkin_log(activity_id,pass_id,apply_order_id,checkin_type,action,checkpoint,operator_name,device_id,occurred_time,idempotency_key,result,reason,create_time) values(#{activityId},#{passId},#{applyOrderId},#{checkinType},#{action},#{checkpoint},#{operatorName},#{deviceId},#{occurredTime},#{idempotencyKey},#{result},#{reason},sysdate())</insert></mapper>
