<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YcGridBottomMapper">
  <resultMap type="YcGridBottom" id="YcGridBottomResult">
    <result property="bottomId" column="bottom_id"/><result property="activityId" column="activity_id"/>
    <result property="bottomName" column="bottom_name"/><result property="bottomType" column="bottom_type"/>
    <result property="linkUrl" column="link_url"/><result property="moduleKey" column="module_key"/>
    <result property="phone" column="phone"/><result property="iconUrl" column="icon_url"/>
    <result property="sortOrder" column="sort_order"/><result property="status" column="status"/>
    <result property="delFlag" column="del_flag"/><result property="createBy" column="create_by"/>
    <result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/>
    <result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
  </resultMap>
  <sql id="selectVo">
    select bottom_id,activity_id,bottom_name,bottom_type,link_url,module_key,phone,icon_url,sort_order,status,del_flag,create_by,create_time,update_by,update_time,remark
    from yc_grid_bottom
  </sql>
  <select id="selectYcGridBottomById" resultMap="YcGridBottomResult"><include refid="selectVo"/> where bottom_id=#{bottomId} and del_flag='0'</select>
  <select id="selectYcGridBottomList" resultMap="YcGridBottomResult">
    <include refid="selectVo"/>
    <where>del_flag='0'
      <if test="activityId!=null">and activity_id=#{activityId}</if>
      <if test="bottomName!=null and bottomName!=''">and bottom_name like concat('%',#{bottomName},'%')</if>
      <if test="bottomType!=null and bottomType!=''">and bottom_type=#{bottomType}</if>
      <if test="status!=null and status!=''">and status=#{status}</if>
    </where>
    order by sort_order asc, bottom_id asc
  </select>
  <select id="selectBottomStats" resultType="java.util.HashMap">
    select count(1) as totalCount, ifnull(sum(case when status='1' then 1 else 0 end),0) as enabledCount
    from yc_grid_bottom where activity_id=#{activityId} and del_flag='0'
  </select>
  <insert id="insertYcGridBottom" useGeneratedKeys="true" keyProperty="bottomId">
    insert into yc_grid_bottom(activity_id,bottom_name,bottom_type,link_url,module_key,phone,icon_url,sort_order,status,del_flag,create_by,create_time,remark)
    values(#{activityId},#{bottomName},#{bottomType},#{linkUrl},#{moduleKey},#{phone},#{iconUrl},#{sortOrder},#{status},'0',#{createBy},sysdate(),#{remark})
  </insert>
  <update id="updateYcGridBottom">
    update yc_grid_bottom
    <set>
      <if test="bottomName!=null">bottom_name=#{bottomName},</if>
      <if test="bottomType!=null">bottom_type=#{bottomType},</if>
      <if test="linkUrl!=null">link_url=#{linkUrl},</if>
      <if test="moduleKey!=null">module_key=#{moduleKey},</if>
      <if test="phone!=null">phone=#{phone},</if>
      <if test="iconUrl!=null">icon_url=#{iconUrl},</if>
      <if test="sortOrder!=null">sort_order=#{sortOrder},</if>
      <if test="status!=null">status=#{status},</if>
      <if test="updateBy!=null">update_by=#{updateBy},</if>
      <if test="remark!=null">remark=#{remark},</if>
      update_time=sysdate()
    </set>
    where bottom_id=#{bottomId}
  </update>
  <delete id="deleteYcGridBottomByIds">
    update yc_grid_bottom set del_flag='2' where bottom_id in
    <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
  </delete>
</mapper>