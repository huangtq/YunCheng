<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YcMealTicketMapper">
  <resultMap type="YcMealTicket" id="YcMealTicketResult">
    <result property="ticketId" column="ticket_id"/><result property="activityId" column="activity_id"/>
    <result property="ticketName" column="ticket_name"/><result property="mealType" column="meal_type"/>
    <result property="mealDate" column="meal_date"/><result property="totalQuota" column="total_quota"/>
    <result property="usedCount" column="used_count"/><result property="enabled" column="enabled"/>
    <result property="sortOrder" column="sort_order"/><result property="delFlag" column="del_flag"/>
    <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
    <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/>
    <result property="remark" column="remark"/>
  </resultMap>
  <sql id="selectVo">
    select ticket_id, activity_id, ticket_name, meal_type, meal_date, total_quota, used_count, enabled,
           sort_order, del_flag, create_by, create_time, update_by, update_time, remark
    from yc_meal_ticket
  </sql>
  <select id="selectYcMealTicketById" resultMap="YcMealTicketResult"><include refid="selectVo"/> where ticket_id=#{ticketId} and del_flag='0'</select>
  <select id="selectYcMealTicketList" resultMap="YcMealTicketResult">
    <include refid="selectVo"/>
    <where>del_flag='0'
      <if test="activityId!=null">and activity_id=#{activityId}</if>
      <if test="ticketName!=null and ticketName!=''">and ticket_name like concat('%',#{ticketName},'%')</if>
      <if test="mealType!=null and mealType!=''">and meal_type=#{mealType}</if>
      <if test="enabled!=null and enabled!=''">and enabled=#{enabled}</if>
    </where>
    order by sort_order asc, ticket_id asc
  </select>
  <select id="selectMealStats" resultType="java.util.HashMap">
    select count(1) as totalCount,
      ifnull(sum(case when enabled='1' then 1 else 0 end),0) as enabledCount,
      ifnull(sum(used_count),0) as usedCount
    from yc_meal_ticket where activity_id=#{activityId} and del_flag='0'
  </select>
  <insert id="insertYcMealTicket" useGeneratedKeys="true" keyProperty="ticketId">
    insert into yc_meal_ticket(activity_id,ticket_name,meal_type,meal_date,total_quota,used_count,enabled,sort_order,del_flag,create_by,create_time,remark)
    values(#{activityId},#{ticketName},#{mealType},#{mealDate},#{totalQuota},#{usedCount},#{enabled},#{sortOrder},'0',#{createBy},sysdate(),#{remark})
  </insert>
  <update id="updateYcMealTicket">
    update yc_meal_ticket
    <set>
      <if test="ticketName!=null">ticket_name=#{ticketName},</if>
      <if test="mealType!=null">meal_type=#{mealType},</if>
      <if test="mealDate!=null">meal_date=#{mealDate},</if>
      <if test="totalQuota!=null">total_quota=#{totalQuota},</if>
      <if test="usedCount!=null">used_count=#{usedCount},</if>
      <if test="enabled!=null">enabled=#{enabled},</if>
      <if test="sortOrder!=null">sort_order=#{sortOrder},</if>
      <if test="updateBy!=null">update_by=#{updateBy},</if>
      <if test="remark!=null">remark=#{remark},</if>
      update_time=sysdate()
    </set>
    where ticket_id=#{ticketId}
  </update>
  <delete id="deleteYcMealTicketByIds">
    update yc_meal_ticket set del_flag='2' where ticket_id in
    <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
  </delete>
</mapper>